# Required for AI question generation + grading.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults are tuned for cost.
# Question generation defaults to Haiku (cheap, fast).
ANTHROPIC_MODEL_GEN=claude-haiku-4-5-20251001
# Free-text grading defaults to Sonnet (more accurate on partial credit).
ANTHROPIC_MODEL_GRADE=claude-sonnet-4-6
